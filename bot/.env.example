# IMAP Client .env example

# IMAP (inbound)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=opuezaz107@gmail.com
IMAP_PASS=your_app_password_here
IMAP_POLL_INTERVAL_SEC=30

# SMTP (outbound)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=opuezaz107@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Poisha Support <charging.bull.org@gmail.com>"

# Optional: webhook in your app to receive inbound emails
SUPPORT_WEBHOOK_URL=

# TELEGRAM (if you wire notifications)
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
